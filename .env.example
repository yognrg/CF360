# ─────────────────────────────────────────────────────────────
# CF360 environment variables
# Copy this file to `.env.local` and fill in values.
# The app runs with the defaults below — no external services required.
# ─────────────────────────────────────────────────────────────

# Secret used to sign the demo session cookie. Any long random string.
# (A default is used if unset, fine for local/demo.)
APP_SESSION_SECRET=change-me-to-a-long-random-string

# Where the local JSON data store lives (relative to project root).
# Leave as-is unless you want the data somewhere else.
CF360_DATA_DIR=.data

# Max upload size in bytes (UI + server both enforce this). 10 MB default.
CF360_MAX_UPLOAD_BYTES=10485760

# ── Optional: swap to Supabase/Postgres later (see SETUP_TODO.md) ──
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
